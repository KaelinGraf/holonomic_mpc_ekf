<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dock_control</name>
  <version>0.0.0</version>
  <description>Docking estimator (EKF), supervisor and MPC for the holonomic demonstrator.</description>
  <maintainer email="kgra470@aucklanduni.ac.nz">dev</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>ament_index_python</exec_depend>
  <!-- convchart_interfaces and convchart_qos come from Conv-ChArT-Wireless-Inference:
       overlay that workspace before building this one. -->
  <exec_depend>convchart_interfaces</exec_depend>
  <exec_depend>convchart_qos</exec_depend>
  <exec_depend>dock_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <!-- No rosdep keys for the QP solvers: pip install daqp==0.10.3 (the default; it has
       an aarch64 wheel) and, for qp_solver:=osqp, osqp (the Pi image pins 1.1.3). -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
